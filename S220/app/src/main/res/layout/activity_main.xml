<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".MainActivity">

    <!-- 1. トップバー（ステータス表示 & メニューボタン） -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_main"
            android:textColor="@color/accent"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/text_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- USB ステータスバッジ -->
        <TextView
            android:id="@+id/tvUsbStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="monospace"
            android:text="USB: 未接続"
            android:textColor="@color/warn"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@+id/tvGpsStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <!-- GPS ステータスバッジ -->
        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="GPS: 測位中…"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvUsbStatus" />

        <!-- 統計サマリ行 -->
        <LinearLayout
            android:id="@+id/statsBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/surface_hi"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            app:layout_constraintTop_toBottomOf="@+id/tvUsbStatus">

            <TextView
                android:id="@+id/tvStatRx"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="RX: 0"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvStatLost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="欠落: 0"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvStatRssi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.6"
                android:fontFamily="monospace"
                android:text="RSSI: ---"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvStatGpx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="GPX: 0点"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. 列ヘッダー (TIME | BODY | RSSI | LOCATION) -->
    <LinearLayout
        android:id="@+id/colHeaders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_hi"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <TextView
            style="@style/S220.ColumnHeader"
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:text="@string/col_time" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            style="@style/S220.ColumnHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/col_body" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp" />

        <TextView
            style="@style/S220.ColumnHeader"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/col_rssi" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="6dp" />

        <TextView
            style="@style/S220.ColumnHeader"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/col_loc" />
    </LinearLayout>

    <!-- ヘッダー下ボーダー -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline"
        app:layout_constraintTop_toBottomOf="@+id/colHeaders" />

    <!-- 3. ログ一覧 (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerDivider" />

    <!-- 空のときのヒントメッセージ -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/empty_hint"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerDivider" />

    <!-- 4. 最新追従が外れた時に出る「最新へジャンプ」ボタン -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFollowLatest"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/accent"
        android:elevation="6dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/follow_latest"
        android:textColor="@color/bg"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="18dp"
        app:icon="@android:drawable/arrow_down_float"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:iconTint="@color/bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>